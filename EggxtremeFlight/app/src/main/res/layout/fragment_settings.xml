<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/menu_background">

    <TextView
        android:id="@+id/settingsTitle"
        android:text="@string/settings_btn_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/game_font"
        android:textColor="#0f0002"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/languageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/game_font"
        android:text="@string/language_title"
        android:textColor="#0f0002"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/settingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/en_btn_language"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <Button
        android:id="@+id/en_btn_language"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:text="@string/english_btn_language"
        android:textStyle="bold"
        android:textSize="20sp"
        android:fontFamily="@font/game_font"
        app:backgroundTint="@null"
        android:background="@drawable/button_background"
        android:textColor="#0f0002"
        android:padding="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        app:layout_constraintTop_toBottomOf="@+id/settingsTitle"
        app:layout_constraintStart_toEndOf="@+id/languageTitle"
        app:layout_constraintEnd_toStartOf="@+id/ru_btn_language"/>

    <Button
        android:id="@+id/ru_btn_language"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:text="@string/russian_btn_language"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/game_font"
        app:backgroundTint="@null"
        android:background="@drawable/button_background"
        android:textColor="#0f0002"
        android:padding="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        app:layout_constraintTop_toBottomOf="@+id/settingsTitle"
        app:layout_constraintStart_toEndOf="@+id/en_btn_language"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>