<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/menu_background">

    <TextView
        android:id="@+id/shopTitle"
        android:text="TEST"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/game_font"
        android:textColor="#0f0002"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/btnSkin1"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/skin1_chicken_mid"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/shopTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSkin2"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginEnd="16dp"/>

    <ImageView
        android:id="@+id/btnSkin2"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/skin2_egg_mid"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/btnSkin1"
        app:layout_constraintBottom_toBottomOf="@id/btnSkin1"
        app:layout_constraintStart_toEndOf="@id/btnSkin1"
        app:layout_constraintEnd_toStartOf="@id/btnSkin3"
        android:layout_marginEnd="16dp"/>

    <ImageView
        android:id="@+id/btnSkin3"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:src="@drawable/skin3_nagget_mid"
        android:scaleType="centerInside"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/btnSkin1"
        app:layout_constraintBottom_toBottomOf="@id/btnSkin1"
        app:layout_constraintStart_toEndOf="@id/btnSkin2"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>